# TomTom Snap to Roads: keep the real key only in local/Railway secrets.
TOMTOM_API_KEY=
MATCH_PROVIDER=tomtom
MATCH_SHADOW_MODE=1

# Conservative limits below TomTom's current free monthly allowance.
TOMTOM_MONTHLY_LIMIT=2200
TOMTOM_WEEKLY_LIMIT=400
TOMTOM_MIN_INTERVAL_SECONDS=1
TOMTOM_WEEKDAY=6
TOMTOM_HOUR=3
MATCH_RUN_ON_START=0

# Raw GPS expires; confirmed aggregate lines remain.
OBSERVED_RAW_RETENTION_DAYS=7
MATCH_MAX_PENDING_JOBS=5000
MATCH_MAX_ATTEMPTS=8
VOLUME_BUDGET_BYTES=5000000000
OBSERVED_MIN_CONFIRMED_BUSES=2
OBSERVED_MIN_CONFIRMED_PASSES=2
